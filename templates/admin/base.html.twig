<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin - MindGrow{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e293b; position: fixed; top: 0; left: 0; padding: 30px 0; z-index: 100; }
        .sidebar .brand { color: #2ecc71; font-size: 1.2rem; font-weight: 700; padding: 0 20px 30px; border-bottom: 1px solid #334155; }
        .sidebar .brand span { display: block; color: #94a3b8; font-size: 11px; font-weight: 400; margin-top: 2px; }
        .sidebar a { display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: #94a3b8; text-decoration: none; font-size: 14px; transition: all 0.2s; }
        .sidebar a:hover, .sidebar a.active { background: #334155; color: white; }
        .main-content { margin-left: 240px; padding: 40px; }
        .card { border-radius: 16px; border: 1px solid #f1f5f9; transition: transform 0.2s, box-shadow 0.2s; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(162,213,171,0.2) !important; border-color: #a2d5ab !important; }
        .btn-success { background: #A2D5AB; border: none; color: #2d3748; font-weight: 600; }
        .btn-success:hover { background: #81c784; color: white; }
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>

<div class="sidebar">
    <div class="brand">MINDGROW <span>Administration</span></div>
    <a href="/admin">👤 Mon Profil</a>
    <a href="/admin/utilisateurs">👥 Utilisateurs</a>
    <a href="/admin/programmes">📋 Programmes</a>
    <a href="/admin/seances">📅 Séances</a>
    <a href="/admin/abonnements">📰 Abonnements</a>
    <a href="/admin/therapeutes" class="{{ app.request.attributes.get('_route') starts with 'admin_therapeute' ? 'active' : '' }}">
        🧑‍⚕️ Thérapeutes
    </a>
</div>

<div class="main-content">
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block extra_js %}{% endblock %}
</body>
</html>