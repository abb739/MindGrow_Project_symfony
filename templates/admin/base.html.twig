<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin - MindGrow{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-bg: #1e293b;
            --sidebar-border: #334155;
            --sidebar-text: #94a3b8;
            --sidebar-hover: #334155;
            --main-bg: #f8fafc;
            --card-bg: #ffffff;
            --card-border: #f1f5f9;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --input-bg: #ffffff;
            --input-border: #e2e8f0;
        }
        body.dark {
            --sidebar-bg: #0f172a;
            --sidebar-border: #1e293b;
            --sidebar-text: #64748b;
            --sidebar-hover: #1e293b;
            --main-bg: #0f172a;
            --card-bg: #1e293b;
            --card-border: #334155;
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --input-bg: #1e293b;
            --input-border: #334155;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--main-bg);
            color: var(--text-main);
            transition: background 0.3s, color 0.3s;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            padding: 30px 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            transition: background 0.3s;
        }
        .sidebar .brand {
            color: #2ecc71;
            font-size: 1.2rem;
            font-weight: 700;
            padding: 0 20px 30px;
            border-bottom: 1px solid var(--sidebar-border);
        }
        .sidebar .brand span {
            display: block;
            color: var(--sidebar-text);
            font-size: 11px;
            font-weight: 400;
            margin-top: 2px;
        }
        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 14px;
            transition: background 0.2s, color 0.2s;
        }
        .sidebar a:hover, .sidebar a.active {
            background: var(--sidebar-hover);
            color: white;
        }
        .sidebar .bottom-section {
            margin-top: auto;
        }
        .sidebar .deconnexion {
            border-top: 1px solid var(--sidebar-border);
        }
        .sidebar .deconnexion a { color: #e74c3c !important; }
        .sidebar .deconnexion a:hover { background: rgba(231,76,60,0.12); }

        /* Theme toggle in sidebar */
        .theme-row {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--sidebar-border);
            border-bottom: 1px solid var(--sidebar-border);
        }
        .theme-row span {
            font-size: 13px;
            color: var(--sidebar-text);
        }
        .theme-toggle {
            width: 44px;
            height: 24px;
            border-radius: 12px;
            background: #334155;
            border: none;
            cursor: pointer;
            position: relative;
            transition: background 0.3s;
            flex-shrink: 0;
        }
        .theme-toggle::after {
            content: '☀️';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            line-height: 20px;
            text-align: center;
            transition: transform 0.3s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.3);
        }
        body.dark .theme-toggle { background: #2ecc71; }
        body.dark .theme-toggle::after { content: '🌙'; transform: translateX(20px); }

        /* Main content */
        .main-content {
            margin-left: 240px;
            padding: 40px;
            min-height: 100vh;
        }

        /* Cards */
        .card {
            border-radius: 16px;
            border: 1px solid var(--card-border) !important;
            background: var(--card-bg) !important;
            color: var(--text-main);
            transition: transform 0.2s, box-shadow 0.2s, background 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(162,213,171,0.2) !important;
            border-color: #a2d5ab !important;
        }

        /* Tables */
        body.dark .table { color: var(--text-main); }
        body.dark .table thead th { border-color: var(--card-border); background: #1e293b; }
        body.dark .table td, body.dark .table th { border-color: var(--card-border); }
        body.dark .table-striped > tbody > tr:nth-of-type(odd) > * { background: rgba(255,255,255,0.03); }
        body.dark .table-hover > tbody > tr:hover > * { background: rgba(255,255,255,0.05); }

        /* Forms */
        body.dark .form-control,
        body.dark .form-select {
            background: var(--input-bg);
            border-color: var(--input-border);
            color: var(--text-main);
        }
        body.dark .form-control:focus,
        body.dark .form-select:focus {
            background: var(--input-bg);
            border-color: #2ecc71;
            color: var(--text-main);
            box-shadow: 0 0 0 3px rgba(46,204,113,0.15);
        }
        body.dark .form-label { color: var(--text-main); }

        /* Alerts */
        body.dark .alert-success { background: #14532d; border-color: #166534; color: #bbf7d0; }
        body.dark .alert-danger  { background: #7f1d1d; border-color: #991b1b; color: #fecaca; }

        /* Text */
        body.dark .text-muted { color: var(--text-muted) !important; }
        body.dark h1, body.dark h2, body.dark h3, body.dark h4, body.dark h5, body.dark h6 { color: var(--text-main); }
        body.dark .badge { background: #334155 !important; color: #94a3b8 !important; }

        /* Buttons */
        .btn-success { background: #A2D5AB; border: none; color: #2d3748; font-weight: 600; }
        .btn-success:hover { background: #81c784; color: white; }

        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>

<div class="sidebar">
    <div class="brand">MINDGROW <span>Administration</span></div>
    <a href="/admin">👤 Mon Profil</a>
    <a href="/admin/utilisateurs">👥 Utilisateurs</a>
    <a href="/admin/programmes">📋 Programmes</a>
    <a href="/admin/seances" class="{{ app.request.attributes.get('_route') starts with 'app_admin_seance' ? 'active' : '' }}">📅 Séances</a>
    <a href="/admin/abonnements">📰 Abonnements</a>
    <a href="/admin/therapeutes" class="{{ app.request.attributes.get('_route') starts with 'admin_therapeute' ? 'active' : '' }}">🧑‍⚕️ Thérapeutes</a>

    <div class="bottom-section">
        <div class="theme-row">
            <span id="themeLabel">Mode clair</span>
            <button class="theme-toggle" id="themeToggle" title="Changer le thème"></button>
        </div>
        <div class="deconnexion">
            <a href="{{ path('front_therapeute_index') }}" style="color:#e74c3c;">🚪 Déconnexion</a>
        </div>
    </div>
</div>

<div class="main-content">
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const toggle = document.getElementById('themeToggle');
    const label  = document.getElementById('themeLabel');
    const body   = document.body;

    function applyTheme(dark) {
        body.classList.toggle('dark', dark);
        label.textContent = dark ? 'Mode sombre' : 'Mode clair';
    }

    applyTheme(localStorage.getItem('theme') === 'dark');

    toggle.addEventListener('click', () => {
        const isDark = body.classList.contains('dark');
        applyTheme(!isDark);
        localStorage.setItem('theme', !isDark ? 'dark' : 'light');
    });
</script>
{% block extra_js %}{% endblock %}
</body>
</html>
