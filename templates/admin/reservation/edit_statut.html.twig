{% extends 'admin/base.html.twig' %}

{% block title %}Admin - Modifier Statut Réservation{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Modifier le Statut de la Réservation</h1>
        <a href="{{ path('app_admin_seance_show', {'id': reservation.seance.id}) }}" class="btn btn-secondary">Retour à la séance</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Détails de la Réservation</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID Réservation</dt>
                        <dd class="col-sm-8">{{ reservation.id }}</dd>

                        <dt class="col-sm-4">Séance</dt>
                        <dd class="col-sm-8">{{ reservation.seance.titre }}</dd>

                        <dt class="col-sm-4">Utilisateur</dt>
                        <dd class="col-sm-8">{{ reservation.utilisateur.prenom }} {{ reservation.utilisateur.nom }}</dd>

                        <dt class="col-sm-4">Date de réservation</dt>
                        <dd class="col-sm-8">{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y H:i') : '' }}</dd>

                        <dt class="col-sm-4">Statut actuel</dt>
                        <dd class="col-sm-8">
                            <span class="badge 
                                {% if reservation.statut == 'confirmée' %}bg-success
                                {% elseif reservation.statut == 'annulée' %}bg-danger
                                {% else %}bg-warning{% endif %}">
                                {{ reservation.statut }}
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Modifier le Statut</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.statut) }}
                            {{ form_widget(form.statut) }}
                            {{ form_errors(form.statut) }}
                        </div>

                        <button type="submit" class="btn btn-success">Mettre à jour</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}