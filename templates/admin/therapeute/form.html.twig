{% extends 'admin/base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
<div style="max-width:700px;">
    <a href="{{ path('admin_therapeute_index') }}" class="btn btn-outline-secondary mb-4">← Retour</a>
    <h3 class="fw-bold mb-4">{{ title }}</h3>

    <div class="card shadow-sm border-0 p-4">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">NOM</label>
                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">PRÉNOM</label>
                {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                {{ form_errors(form.prenom) }}
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">SPÉCIALITÉ</label>
                {{ form_widget(form.specialite, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.specialite) }}
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">EMAIL</label>
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'required': 'required', 'pattern': '.+@.+', 'title': 'L\'email doit contenir @'}}) }}
                {{ form_errors(form.email) }}
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">TÉLÉPHONE</label>
                {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.telephone) }}
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">PHOTO DE PROFIL</label>
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-12">
                <label class="form-label fw-bold">CERTIFICAT (PDF/Image)</label>
                {{ form_widget(form.certificatFile, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="{{ path('admin_therapeute_index') }}" class="btn btn-dark">Annuler</a>
            <button type="submit" class="btn btn-success px-4">💾 Enregistrer</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}