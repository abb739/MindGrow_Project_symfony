<form method="post" action="{{ path('app_admin_seance_delete', {'id': seance.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette séance ?');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seance.id) }}">
    <button class="btn btn-danger">Supprimer cette séance</button>
</form>
