{% extends 'seance/index.html.twig' %}

{% block title %}Séances - MindGrow{% endblock %}

{% block body %}
<div class="container my-5">
    <!-- Titre et bouton Mes Réservations -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="text-center text-md-start mb-4 mb-md-0">
                <i class="fas fa-calendar-alt text-success"></i> Nos Séances
            </h1>
        </div>
        <div class="col-md-6 text-center text-md-end">
            <button id="btnReservations" class="btn btn-success">
                <i class="fas fa-book"></i> Mes Réservations
            </button>
        </div>
    </div>

    <!-- Liste des Séances -->
    <div class="row">
        {% for titre, seances in seancesGrouped %}
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                {% set image = seances[0].image %}
                {% if image %}
                    <img src="{{ asset('uploads/seances/' ~ image) }}" class="card-img-top" alt="{{ titre }}" style="height:200px; object-fit:cover;">
                {% else %}
                    <img src="{{ asset('uploads/seances/default.jpg') }}" class="card-img-top" alt="{{ titre }}" style="height:200px; object-fit:cover;">
                {% endif %}
                <div class="card-body text-center">
                    <h5 class="card-title">{{ titre }}</h5>
                    <p class="card-text text-muted">
                        {{ seances|length }} séance{{ seances|length > 1 ? 's' : '' }}
                    </p>
                    <a href="{{ path('app_seance_detail', {'titre': titre}) }}" class="btn btn-primary">
                        <i class="fas fa-eye"></i> Voir les détails
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {% if seancesGrouped is empty %}
    <div class="row">
        <div class="col-12 text-center">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Aucune séance disponible pour le moment.
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Bloc Mes Réservations (caché par défaut) -->
    <div id="mesReservations" style="display:none;" class="my-5">
        <h3 class="mb-3">Mes Réservations</h3>
        {% if reservations is empty %}
            <div class="alert alert-info">Vous n'avez aucune réservation pour le moment.</div>
        {% else %}
            <div class="list-group">
                {% for res in reservations %}
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{ res.seance.titre }}</strong><br>
                            Date : {{ res.seance.date|date('d/m/Y H:i') }}
                        </div>
                        <span class="badge bg-success rounded-pill">{{ res.status }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
.card { border-radius: 16px; transition: transform 0.2s, box-shadow 0.2s; }
.card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
</style>

<script>
document.getElementById('btnReservations').addEventListener('click', function() {
    const resDiv = document.getElementById('mesReservations');
    resDiv.style.display = resDiv.style.display === 'none' ? 'block' : 'none';
});
</script>
{% endblock %}
