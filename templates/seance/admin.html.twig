{% extends 'base.html.twig' %}
{% block title %}Admin — Gestion des Séances{% endblock %}
{% block body %}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px;">
    <h1 class="page-title" style="margin-bottom:0;">🎯 Gestion des Séances</h1>
    <div style="display:flex; gap:10px;">
        <a href="?tri=date" class="btn {{ tri == 'date' ? 'btn-primary' : '' }}" style="{{ tri != 'date' ? 'background:var(--bg3); color:var(--text2);' : '' }}">📅 Par date</a>
        <a href="?tri=capacite_desc" class="btn {{ tri == 'capacite_desc' ? 'btn-primary' : '' }}" style="{{ tri != 'capacite_desc' ? 'background:var(--bg3); color:var(--text2);' : '' }}">⬇ Capacité</a>
        <a href="?tri=capacite_asc" class="btn {{ tri == 'capacite_asc' ? 'btn-primary' : '' }}" style="{{ tri != 'capacite_asc' ? 'background:var(--bg3); color:var(--text2);' : '' }}">⬆ Capacité</a>
    </div>
</div>

{# Barre de recherche admin #}
<div class="card" style="margin-bottom:20px;">
    <form method="get" action="{{ path('admin_seances') }}" style="display:flex; gap:12px; align-items:center;">
        <input type="text" name="search" value="{{ search }}" placeholder="🔍 Rechercher par titre ou lieu..." style="flex:1; margin:0;">
        <button type="submit" class="btn btn-primary">Rechercher</button>
        {% if search %}
        <a href="{{ path('admin_seances') }}" class="btn" style="background:var(--bg3); color:var(--text2);">✕ Effacer</a>
        {% endif %}
    </form>
</div>

{% if errors is defined and errors %}
    {% for error in errors %}
        <div class="alert-error">⚠️ {{ error }}</div>
    {% endfor %}
{% endif %}

{# Formulaire d'ajout AVEC upload image #}
<div class="card">
    <h3 style="font-size:16px; font-weight:600; margin-bottom:20px; color:var(--label);">➕ Ajouter une séance</h3>
    <form method="post" action="{{ path('admin_seance_new') }}" enctype="multipart/form-data">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="form-group">
                <label>Titre * (min. 3 caractères)</label>
                <input type="text" name="titre" required minlength="3" maxlength="100" placeholder="Ex: Méditation pleine conscience">
            </div>
            <div class="form-group">
                <label>Lieu *</label>
                <input type="text" name="lieu" required placeholder="Ex: Salle Zen, Tunis">
            </div>
            <div class="form-group">
                <label>Date début *</label>
                <input type="datetime-local" name="dateDebut" required>
            </div>
            <div class="form-group">
                <label>Date fin *</label>
                <input type="datetime-local" name="dateFin" required>
            </div>
            <div class="form-group">
                <label>Capacité * (1–10000)</label>
                <input type="number" name="capacite" required min="1" max="10000" placeholder="Ex: 20">
            </div>
            <div class="form-group">
                <label>Description</label>
                <input type="text" name="description" placeholder="Description optionnelle">
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label>🖼️ Image de la séance (JPG, PNG, WEBP — max 2 Mo)</label>
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp"
                       style="padding:8px; cursor:pointer; background:var(--input-bg); color:var(--text); border:2px solid var(--border2); border-radius:10px; width:100%;">
                <div style="font-size:12px; color:var(--text3); margin-top:4px;">Laissez vide pour ne pas mettre d'image.</div>
            </div>
        </div>
        <button type="submit" class="btn btn-success">➕ Ajouter la séance</button>
    </form>
</div>

{# Tableau des séances #}
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Titre</th>
            <th>Lieu</th>
            <th>Date début</th>
            <th>Date fin</th>
            <th>Capacité</th>
            <th>📊 Réservations</th>
            <th>Remplissage</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for seance in seances %}
    <tr>
        <td><span class="badge badge-primary">#{{ seance.id }}</span></td>
        <td>
            {% if seance.image and seance.image starts with '/uploads/' %}
                <img src="{{ seance.image }}" alt="{{ seance.titre }}"
                     style="width:50px; height:50px; object-fit:cover; border-radius:8px; border:2px solid var(--border2);">
            {% else %}
                <div style="width:50px; height:50px; border-radius:8px; background:var(--bg3); display:flex; align-items:center; justify-content:center; font-size:20px;">🎯</div>
            {% endif %}
        </td>
        <td style="font-weight:600;">{{ seance.titre }}</td>
        <td style="color:var(--text2); font-size:13px;">{{ seance.lieu|slice(0,40) }}{% if seance.lieu|length > 40 %}...{% endif %}</td>
        <td>{{ seance.dateDebut ? seance.dateDebut|date('d/m/Y H:i') : '—' }}</td>
        <td>{{ seance.dateFin ? seance.dateFin|date('d/m/Y H:i') : '—' }}</td>
        <td><span class="badge badge-warning">{{ seance.capacite }}</span></td>
        <td>
            {% if statsReservations[seance.id] is defined %}
                <strong style="color:#0b7a8f;">{{ statsReservations[seance.id].nb }}</strong> / {{ seance.capacite }}
            {% else %}
                0 / {{ seance.capacite }}
            {% endif %}
        </td>
        <td>
            {% set taux = statsReservations[seance.id] is defined ? statsReservations[seance.id].taux : 0 %}
            <div style="background:var(--bg3); border-radius:6px; height:10px; width:80px; overflow:hidden;">
                <div style="background:{{ taux >= 80 ? '#ef4444' : (taux >= 50 ? '#f59e0b' : '#10b981') }}; height:100%; width:{{ taux }}%;"></div>
            </div>
            <small style="color:var(--text2);">{{ taux }}%</small>
        </td>
        <td>
            <button onclick="document.getElementById('edit-{{ seance.id }}').style.display='flex'"
                    class="btn btn-warning btn-sm">✏️</button>
            <a href="{{ path('admin_seance_delete', {id: seance.id}) }}"
               onclick="return confirm('Supprimer la séance « {{ seance.titre }} » ?')"
               class="btn btn-danger btn-sm">🗑️</a>

            {# Modal édition #}
            <div id="edit-{{ seance.id }}" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:999; align-items:center; justify-content:center;">
                <div class="card" style="width:620px; max-height:85vh; overflow-y:auto; margin:auto; position:relative;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                        <h3 style="margin:0;">✏️ Modifier : {{ seance.titre }}</h3>
                        <button type="button" onclick="document.getElementById('edit-{{ seance.id }}').style.display='none'"
                                style="background:none; border:none; font-size:20px; cursor:pointer; color:var(--text2);">✕</button>
                    </div>
                    <form method="post" action="{{ path('admin_seance_edit', {id: seance.id}) }}" enctype="multipart/form-data">
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                            <div class="form-group">
                                <label>Titre *</label>
                                <input type="text" name="titre" value="{{ seance.titre }}" required minlength="3">
                            </div>
                            <div class="form-group">
                                <label>Lieu *</label>
                                <input type="text" name="lieu" value="{{ seance.lieu }}" required>
                            </div>
                            <div class="form-group">
                                <label>Date début *</label>
                                <input type="datetime-local" name="dateDebut"
                                       value="{{ seance.dateDebut ? seance.dateDebut|date('Y-m-d\\TH:i') : '' }}" required>
                            </div>
                            <div class="form-group">
                                <label>Date fin *</label>
                                <input type="datetime-local" name="dateFin"
                                       value="{{ seance.dateFin ? seance.dateFin|date('Y-m-d\\TH:i') : '' }}" required>
                            </div>
                            <div class="form-group">
                                <label>Capacité *</label>
                                <input type="number" name="capacite" value="{{ seance.capacite }}" required min="1">
                            </div>
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" name="description" value="{{ seance.description }}">
                            </div>
                            <div class="form-group" style="grid-column:1/-1;">
                                <label>🖼️ Changer l'image (laisser vide pour garder l'actuelle)</label>
                                {% if seance.image and seance.image starts with '/uploads/' %}
                                <div style="margin-bottom:8px;">
                                    <img src="{{ seance.image }}" style="height:80px; border-radius:8px; object-fit:cover;">
                                </div>
                                {% endif %}
                                <input type="file" name="image" accept="image/jpeg,image/png,image/webp"
                                       style="padding:8px; cursor:pointer; background:var(--input-bg); color:var(--text); border:2px solid var(--border2); border-radius:10px; width:100%;">
                            </div>
                        </div>
                        <div style="display:flex; gap:10px; margin-top:10px;">
                            <button type="submit" class="btn btn-success">💾 Sauvegarder</button>
                            <button type="button" onclick="document.getElementById('edit-{{ seance.id }}').style.display='none'"
                                    class="btn" style="background:var(--bg3); color:var(--text2);">Annuler</button>
                        </div>
                    </form>
                </div>
            </div>
        </td>
    </tr>
    {% else %}
    <tr><td colspan="10" style="text-align:center; color:var(--text3); padding:40px;">
        {% if search %}Aucune séance trouvée pour "{{ search }}"{% else %}Aucune séance enregistrée{% endif %}
    </td></tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}
