{% extends 'base.html.twig' %}
{% block title %}Gestion Abonnements{% endblock %}
{% block body %}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
    <h1 class="page-title" style="margin:0;">📋 Gestion des Abonnements</h1>
    {# ===== CHANGEMENT DE DEVISE ===== #}
    <div style="display:flex; align-items:center; gap:10px; background:white; border-radius:12px; padding:10px 18px; box-shadow:0 2px 12px rgba(0,0,0,.07);">
        <span style="font-size:13px; font-weight:600; color:#64748b;">💱 Devise :</span>
        <select id="deviseSelect" onchange="changerDevise(this.value)"
            style="padding:8px 12px; border:2px solid #e2e8f0; border-radius:8px; font-size:14px; font-weight:600; color:#0b7a8f; background:white; cursor:pointer; outline:none;">
            <option value="TND">🇹🇳 Dinar (TND)</option>
            <option value="EUR">🇪🇺 Euro (EUR)</option>
            <option value="USD">🇺🇸 Dollar (USD)</option>
            <option value="GBP">🇬🇧 Livre (GBP)</option>
        </select>
        <span id="tauxInfo" style="font-size:11px; color:#94a3b8; white-space:nowrap;"></span>
    </div>
</div>

{% if errors is defined and errors|length > 0 %}
<div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:14px 18px; margin-bottom:20px; color:#dc2626;">
    {% for e in errors %}<div>⚠️ {{ e }}</div>{% endfor %}
</div>
{% endif %}

<div class="card">
    <h3 style="font-size:16px; font-weight:600; margin-bottom:20px; color:#374151;">➕ Ajouter un abonnement</h3>
    <form method="post" action="{{ path('admin_abonnement_new') }}">
        <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end;">
            <div style="flex:1; min-width:140px;">
                <label>Nom *</label>
                <input type="text" name="nom" required placeholder="Ex: Premium" value="{{ form.nom ?? '' }}">
            </div>
            <div style="flex:1; min-width:120px;">
                <label>Prix (TND) *</label>
                <input type="number" name="prix" required min="0.01" step="0.01" placeholder="49.99" value="{{ form.prix ?? '' }}">
            </div>
            <div style="flex:1; min-width:130px;">
                <label>Durée *</label>
                <select name="dureeMois" required>
                    {% for d in [1,3,6,12,24] %}
                    <option value="{{ d }}" {{ (form.duree ?? '') == d ? 'selected' : '' }}>{{ d }} mois</option>
                    {% endfor %}
                </select>
            </div>
            <div style="flex:2; min-width:180px;">
                <label>Description</label>
                <input type="text" name="description" placeholder="Description de l'offre" value="{{ form.description ?? '' }}">
            </div>
            <div>
                <button type="submit" class="btn btn-success">➕ Ajouter</button>
            </div>
        </div>
    </form>
</div>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prix <span id="deviseHeader" style="font-size:11px; font-weight:400; color:#94a3b8;">(TND)</span></th>
            <th>Durée</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for abo in abonnements %}
    <tr>
        <td><span class="badge badge-primary">#{{ abo.id }}</span></td>
        <td style="font-weight:600;">{{ abo.nom }}</td>
        <td>
            <strong style="color:#0b7a8f;">
                <span class="prix-converti" data-tnd="{{ abo.prix }}">{{ abo.prix }}</span>
                <span class="devise-label-cell">TND</span>
            </strong>
            <br><small style="color:#94a3b8; font-size:11px;">
                ≈ <span class="prix-mois" data-tnd="{{ abo.dureeMois > 1 ? (abo.prix / abo.dureeMois)|number_format(2) : abo.prix }}">
                    {{ abo.dureeMois > 1 ? (abo.prix / abo.dureeMois)|number_format(2) : abo.prix }}
                </span>
                <span class="devise-label-cell">TND</span>/mois
            </small>
        </td>
        <td><span class="badge badge-warning">{{ abo.dureeMois }} mois</span></td>
        <td style="color:#64748b;">{{ abo.description }}</td>
        <td>
            <form method="post" action="{{ path('admin_abonnement_edit', {id: abo.id}) }}" style="display:inline-flex; gap:6px; align-items:center; flex-wrap:wrap;">
                <input type="text" name="nom" value="{{ abo.nom }}" style="width:90px; padding:6px 8px; margin:0; font-size:13px;">
                <input type="number" name="prix" value="{{ abo.prix }}" style="width:75px; padding:6px 8px; margin:0; font-size:13px;" step="0.01">
                <select name="dureeMois" style="width:85px; padding:6px 8px; margin:0; font-size:13px;">
                    {% for d in [1,3,6,12,24] %}
                    <option value="{{ d }}" {{ abo.dureeMois == d ? 'selected' : '' }}>{{ d }}m</option>
                    {% endfor %}
                </select>
                <input type="text" name="description" value="{{ abo.description }}" style="width:110px; padding:6px 8px; margin:0; font-size:13px;">
                <button type="submit" class="btn btn-warning btn-sm">✏️</button>
            </form>
            <a href="{{ path('admin_abonnement_delete', {id: abo.id}) }}"
               onclick="return confirm('Supprimer cet abonnement ?')"
               class="btn btn-danger btn-sm">🗑️</a>
        </td>
    </tr>
    {% endfor %}
    </tbody>
</table>

<script>
const taux     = { TND: 1,    EUR: 0.30, USD: 0.32, GBP: 0.26 };
const symboles = { TND: 'TND', EUR: '€',  USD: '$',  GBP: '£'  };
const noms     = { TND: 'Dinar tunisien', EUR: 'Euro', USD: 'Dollar américain', GBP: 'Livre sterling' };

function changerDevise(devise) {
    const t = taux[devise];
    const s = symboles[devise];

    document.querySelectorAll('.prix-converti').forEach(el => {
        el.textContent = (parseFloat(el.dataset.tnd) * t).toFixed(2);
    });
    document.querySelectorAll('.prix-mois').forEach(el => {
        el.textContent = (parseFloat(el.dataset.tnd) * t).toFixed(2);
    });
    document.querySelectorAll('.devise-label-cell').forEach(el => {
        el.textContent = s;
    });

    // Mettre à jour le header de colonne
    document.getElementById('deviseHeader').textContent = '(' + s + ')';

    // Info taux
    const info = document.getElementById('tauxInfo');
    if (devise !== 'TND') {
        info.textContent = '1 TND ≈ ' + t.toFixed(2) + ' ' + s;
    } else {
        info.textContent = '';
    }

    localStorage.setItem('devise_admin', devise);
}

window.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('devise_admin');
    if (saved && saved !== 'TND') {
        document.getElementById('deviseSelect').value = saved;
        changerDevise(saved);
    }
});
</script>

{% endblock %}
