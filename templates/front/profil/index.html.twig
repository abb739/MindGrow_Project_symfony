{% extends 'base.html.twig' %}
{% block title %}Mon Profil - MindGrow{% endblock %}

{% block extra_css %}
.profil-label { font-size: 12px; font-weight: 600; color: #94a3b8; letter-spacing: 0.5px; }
.profil-input { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; font-size: 15px; width: 100%; }
.profil-input:focus { outline: none; border-color: #A2D5AB; box-shadow: 0 0 0 3px rgba(162,213,171,0.2); }
{% endblock %}

{% block body %}
<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0 p-4 p-md-5" style="max-width:500px;width:100%;border-radius:20px;">
        <h2 class="fw-bold text-center mb-4" style="color:#2d3748;">Mon Profil</h2>

        <form method="post" action="{{ path('front_profil') }}">
            <div class="mb-3">
                <label class="profil-label mb-1 d-block">NOM</label>
                <input type="text" name="nom" class="profil-input" value="" placeholder="Votre nom">
            </div>

            <div class="mb-3">
                <label class="profil-label mb-1 d-block">PRÉNOM</label>
                <input type="text" name="prenom" class="profil-input" value="" placeholder="Votre prénom">
            </div>

            <div class="mb-3">
                <label class="profil-label mb-1 d-block">EMAIL</label>
                <input type="email" name="email" class="profil-input" value="" placeholder="Votre email">
            </div>

            <div class="mb-4">
                <label class="profil-label mb-1 d-block">NOUVEAU MOT DE PASSE</label>
                <input type="password" name="password" class="profil-input" placeholder="Laissez vide si inchangé">
            </div>

            <div class="d-flex gap-3">
                <button type="submit" name="action" value="update"
                        class="btn flex-fill fw-bold py-3"
                        style="background:#A2D5AB;color:#2d3748;border-radius:12px;">
                    💾 Enregistrer
                </button>
                <button type="submit" name="action" value="delete"
                        class="btn flex-fill fw-bold py-3"
                        style="background:#ff7675;color:white;border-radius:12px;">
                    🗑 Supprimer Compte
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
