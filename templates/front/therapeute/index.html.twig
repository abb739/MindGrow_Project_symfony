{% extends 'base.html.twig' %}
{% block title %}Nos Therapeutes - MindGrow{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Nos Therapeutes</h1>
        <p class="text-muted">Un accompagnement bienveillant pour votre equilibre.</p>
        <a href="{{ path('front_goto_admin') }}" class="btn btn-outline-secondary mt-3">Aller au back-office</a>
    </div>

    <form method="get" class="d-flex justify-content-center mb-4">
        <input type="text" name="search" value="{{ search }}"
               class="form-control" style="max-width:500px;border-radius:25px;padding:10px 20px;"
               placeholder="Rechercher...">
        <button type="submit" class="btn btn-primary ms-2">Rechercher</button>
    </form>

    <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
        <a href="{{ path('front_therapeute_index') }}"
           class="chip {{ selectedSpec == '' ? 'active' : '' }}">Tous</a>
        {% for spec in specialites %}
            <a href="{{ path('front_therapeute_index', {specialite: spec, search: search}) }}"
               class="chip {{ selectedSpec == spec ? 'active' : '' }}">{{ spec }}</a>
        {% endfor %}
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        {% for t in therapeutes %}
        <div class="col">
            <div class="card h-100 shadow-sm border-0 text-center p-3" onclick="window.location='{{ path('front_therapeute_show', {id: t.id}) }}'" style="cursor:pointer;">
                {% if t.image %}
                    <img src="{{ asset('uploads/' ~ t.image) }}"
                         style="width:90px;height:90px;border-radius:50%;object-fit:cover;margin:0 auto 10px;">
                {% else %}
                    <div class="avatar-initials mb-2">
                        {{ t.nom|first|upper }}{{ t.prenom|first|upper }}
                    </div>
                {% endif %}

                <h5 class="fw-bold mb-1">{{ t.nom }} {{ t.prenom }}</h5>

                {% if t.specialite %}
                    <span class="badge mb-2" style="background:#e8f4f8;color:#0b7a8f;">{{ t.specialite }}</span>
                {% endif %}

                <p class="text-muted small mb-0">{{ t.email }}</p>
                <p class="text-muted small">{{ t.telephone }}</p>

                <div class="mb-1">
                    {% set avg = t.moyenneNote %}
                    {% for i in 1..5 %}
                        <span style="font-size:18px;color:{{ i <= avg ? '#f39c12' : '#bdc3c7' }};">
                            {{ i <= avg ? '★' : '☆' }}
                        </span>
                    {% endfor %}
                </div>
                <small class="text-muted">{{ avg }}/5 ({{ t.avis|length }} avis)</small>

                <div class="mt-3 d-flex flex-column gap-2">
                    <a href="{{ path('front_therapeute_avis', {id: t.id}) }}"
                       class="btn btn-warning btn-sm fw-bold">Donner un avis</a>
                    <a href="{{ path('front_therapeute_show', {id: t.id}) }}"
                       class="btn btn-outline-secondary btn-sm">Voir les avis</a>
                </div>
            </div>
        </div>
        {% else %}
            <div class="col-12 text-center text-muted">
                <p>Aucun therapeute trouve.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}